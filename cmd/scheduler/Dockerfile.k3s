# K3s优化的轻量级Dockerfile
FROM python:3.11-slim AS python-base

# 安装Python依赖
RUN pip3 install --no-cache-dir numpy scipy matplotlib deap

# 构建阶段
FROM golang:1.21-alpine AS builder

# 安装必要的包
RUN apk add --no-cache git python3

# 设置工作目录
WORKDIR /app

# 复制go mod文件
COPY cmd/scheduler/go.mod cmd/scheduler/go.sum ./

# 下载依赖
RUN go mod download

# 复制源代码
COPY cmd/scheduler/ ./

# 编译二进制文件（K3s优化：减小二进制大小）
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s -extldflags '-static'" -o uav-scheduler .

# 运行阶段 - 使用轻量级基础镜像
FROM python:3.11-slim

# 只安装必要的系统包
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 创建非root用户
RUN useradd -m -u 1001 uav-scheduler

# 设置工作目录
WORKDIR /app

# 从构建阶段复制文件
COPY --from=builder /app/uav-scheduler .
COPY --from=builder /app/RUN2.py .
COPY --from=python-base /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=python-base /usr/local/bin /usr/local/bin

# 设置权限
RUN chmod +x uav-scheduler RUN2.py

# 创建临时目录
RUN mkdir -p /tmp && chmod 777 /tmp

# 切换到非root用户
USER uav-scheduler

# 暴露端口
EXPOSE 8080 8081

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8081/health || exit 1

# 启动命令
CMD ["./uav-scheduler"]